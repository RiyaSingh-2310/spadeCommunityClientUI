# Local development
VITE_API_BASE_URL=http://localhost:5050

# Production (REQUIRED in Vercel — without this, signup fails for all users except your machine)
# VITE_API_BASE_URL=https://adminapi-spadecommunity.onrender.com

VITE_API_BEARER_TOKEN=your_bearer_token_here

# Google reCAPTCHA v2 Checkbox ONLY (visible "I'm not a robot" widget).
# Create at https://www.google.com/recaptcha/admin → Challenge (v2) → "I'm not a robot" Checkbox.
# Secret key goes on the BACKEND only — never add it here.
VITE_RECAPTCHA_SITE_KEY=your_v2_checkbox_site_key_here

# Temporary diagnostics (logs to console in dev + production). Set to "false" to disable.
# VITE_RECAPTCHA_DEBUG=true

# --- Vercel deployment checklist ---
# 1. Vercel → Project → Settings → Environment Variables
# 2. REQUIRED for Production AND Preview (Vite bakes env at build time):
#    VITE_API_BASE_URL=https://adminapi-spadecommunity.onrender.com
#    VITE_RECAPTCHA_SITE_KEY=<your v2 checkbox site key>
# 3. Redeploy after changing env vars (build fails if API URL is missing in production)
# 4. Google reCAPTCHA Admin → Domains — add each exact hostname:
#    - localhost (dev)
#    - your-production-domain.com
#    - your-project.vercel.app (production Vercel URL)
#    - each preview URL (e.g. your-project-abc123.vercel.app) — wildcards are NOT supported
# 5. Backend: verify tokens server-side with the matching Secret Key (never expose secret in frontend)
# 6. Ensure site key type is v2 Checkbox — not v3, Invisible, or Enterprise
