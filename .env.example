VITE_API_BASE_URL=http://localhost:5050
VITE_API_BEARER_TOKEN=your_bearer_token_here

# Google reCAPTCHA v2 Checkbox ONLY (visible "I'm not a robot" widget).
# Create at https://www.google.com/recaptcha/admin → Challenge (v2) → "I'm not a robot" Checkbox.
# Secret key goes on the BACKEND only — never add it here.
VITE_RECAPTCHA_SITE_KEY=your_v2_checkbox_site_key_here

# Temporary diagnostics (logs to console in dev + production). Set to "false" to disable.
# VITE_RECAPTCHA_DEBUG=true

# --- Vercel deployment ---
# 1. Vercel → Project → Settings → Environment Variables
# 2. Add VITE_RECAPTCHA_SITE_KEY for Production AND Preview
# 3. Redeploy (Vite bakes env vars in at build time — changing vars requires a new build)
# 4. Google reCAPTCHA Admin → Domains: add each exact hostname:
#    - your-production-domain.com
#    - your-project.vercel.app
#    - each preview URL (e.g. your-project-abc123.vercel.app) OR use a custom domain only
