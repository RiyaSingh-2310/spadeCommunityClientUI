VITE_API_BASE_URL=http://localhost:5050
VITE_API_BEARER_TOKEN=your_bearer_token_here

# Google reCAPTCHA v2 Checkbox ONLY (visible "I'm not a robot" widget).
# Create at https://www.google.com/recaptcha/admin → Challenge (v2) → "I'm not a robot" Checkbox.
# Secret key goes on the BACKEND only — never add it here.
# Domains: localhost, 127.0.0.1, your production domain, and each Vercel preview hostname.
VITE_RECAPTCHA_SITE_KEY=your_v2_checkbox_site_key_here
